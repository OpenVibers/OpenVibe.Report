# OpenVibe.Report — environment (production: /etc/openvibe/report.env). Names only; never commit values.

NODE_ENV=production
PORT=5080
HOST=127.0.0.1
BASE_URL=https://openvibe.report
TRUST_PROXY=2

# OpenVibe.Network's open stats (GET /api/v1/stats?days=7|30|90). Both sources serve these read APIs on loopback;
# the defaults are the internalOrigin values in openvibe-contracts' manifests/services/{network,live}.json.
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000

# OpenVibe.Live's Rundown and after-show reports (GET /api/rundown/*, /api/recap/*).
OV_LIVE_INTERNAL_URL=http://127.0.0.1:3000

# Optional: the per-address API limit (default 120 a minute) and the readiness probe timeout (default 2500 ms).
#REPORT_API_RATE_LIMIT_PER_MIN=120
#REPORT_READY_TIMEOUT_MS=2500

# Optional: the deployed commit for /release.json. Without it the release is read from git in the checkout.
#RELEASE_COMMIT=

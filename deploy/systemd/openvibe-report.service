[Unit]
Description=OpenVibe.Report — Every number on OpenVibe, honest.
# Network, Live and Billing should be up first, but Report degrades honestly without either read API. The database
# is required after REPORT_SOURCE=report; before that it is the shadow store.
After=network.target openvibe-network.service openvibe-live.service
Wants=openvibe-network.service openvibe-live.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.report
EnvironmentFile=/etc/openvibe/report.env
Environment=NODE_ENV=production
Environment=PORT=5080
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.report/server/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
# In-flight requests get the 10 s drain.
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
